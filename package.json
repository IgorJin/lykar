{
  "name": "lykar",
  "version": "0.0.0",
  "private": true,
  "description": "Versioned visual editing and replay for web pages",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run migrate --workspace lykar-lib-server",
    "dev:api": "npm run dev --workspace lykar-lib-server",
    "dev:admin": "npm run dev --workspace @lykar/admin",
    "dev:editor": "npm run dev --workspace lykar-lib",
    "dev:playground": "npm run dev --workspace @lykar/playground"
  },
  "engines": {
    "node": ">=20"
  }
}
