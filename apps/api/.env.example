DATABASE_URL=postgres://postgres:postgres@localhost:5432/lykar
LYKAR_OWNER_EMAIL=owner@example.com
LYKAR_ANALYTICS_SIGNING_SECRET=replace-with-at-least-32-random-characters
LYKAR_ANALYTICS_RETENTION_DAYS=90
LYKAR_APP_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:4173
HOST=127.0.0.1
PORT=3000
# Local only. Requires a non-production NODE_ENV and loopback binding/origin.
LYKAR_DEV_AUTH=1

# No external delivery or API key is required locally. Disabled mode returns 503.
LYKAR_EMAIL_MODE=disabled
LYKAR_EMAIL_REQUEST_MAX=3
LYKAR_EMAIL_REQUEST_WINDOW_SECONDS=3600
LYKAR_EMAIL_REQUEST_COOLDOWN_SECONDS=60
LYKAR_EMAIL_ACTOR_MAX=30
# Production: a stable random secret, shared by all API processes (>=32 chars).
# LYKAR_EMAIL_LIMIT_SECRET=
# Local capture: set MODE=file and an absolute private output file; loopback only.
# LYKAR_MAGIC_LINK_FILE=/tmp/lykar-local-emails.ndjson
# External delivery (later): MODE=providers; keys in environment only.
# Example budgets are illustrative: verify actual account limits and billing anchor.
# LYKAR_EMAIL_PROVIDERS=[{"id":"resend-main","type":"resend","apiKeyEnv":"RESEND_API_KEY","from":"login@example.com","dailyLimit":100,"periodLimit":3000,"reservedDaily":10,"reservedPeriod":300,"period":{"kind":"calendar-month","anchor":"2026-10-01T00:00:00Z"}},{"id":"mailersend-main","type":"mailersend","apiKeyEnv":"MAILERSEND_API_KEY","from":"login@example.com","dailyLimit":100,"periodLimit":500,"reservedDaily":10,"reservedPeriod":50,"period":{"kind":"days","days":30,"anchor":"2026-10-01T00:00:00Z"}}]
# RESEND_API_KEY=
# MAILERSEND_API_KEY=

# Customer installation instructions: optional externally reachable API override.
# LYKAR_INSTALL_API_BASE_URL=https://api.example.com
# Production requires both release values before an install snippet is offered.
# Examples only; publish these actual immutable assets in stage 12 first.
# LYKAR_SDK_RELEASE_VERSION=1.2.3
# LYKAR_SDK_RELEASE_BASE_URL=https://assets.example.com/lykar/1.2.3/
